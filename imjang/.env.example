# 공공데이터포털 국토교통부 실거래가 API 키 (Decoding 키)
# https://www.data.go.kr 에서 "국토교통부_아파트 매매 실거래가 자료" 등을 신청해 발급받는다.
# 이 파일을 .env 로 복사해 값을 채운다. .env 는 커밋하지 않는다.
VITE_MOLIT_KEY=

# 실거래가 API 베이스 URL.
# 기본값은 공공데이터포털 원본이다. 브라우저에서 CORS 로 막히면
# 직접 띄운 프록시 주소로 바꾼다. (예: https://내프록시/1613000)
VITE_MOLIT_BASE=https://apis.data.go.kr/1613000

# ── 지도 타일 ────────────────────────────────────────────────
# 아무것도 넣지 않으면 OpenStreetMap 을 쓴다 (키 불필요).
#
# 한국 지명·건물·도로명이 제대로 나오는 국토교통부 VWorld 를 쓰려면
# https://www.vworld.kr 에서 인증키(무료)를 발급받아 아래에 넣는다.
# 발급할 때 이 앱을 올릴 도메인을 등록해야 한다.
VITE_VWORLD_KEY=
# Base(기본) / gray / midnight / Satellite(위성) / Hybrid(위성+지명)
VITE_VWORLD_LAYER=Base

# 그 밖의 타일 제공자를 직접 지정할 때 (위 설정보다 우선한다)
# VITE_TILE_URL=https://내타일서버/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=© 제공자
# VITE_TILE_MAX_ZOOM=19
